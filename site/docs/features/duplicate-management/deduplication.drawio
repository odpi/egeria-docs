          <mxGeometry x="1055.5" y="3055" width="50" height="160" as="geometry" />
        </mxCell>
        <mxCell id="_7s_tXQE-3pGkLiUzSX8-95" value="" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.annotation_1;align=left;pointerEvents=1;rotation=-180;" parent="gnqIJqzOAcxfO6BO2laW-1" vertex="1">
          <mxGeometry x="1161.5" y="3055" width="50" height="160" as="geometry" />
        </mxCell>
        <mxCell id="hMZutguz3fgAF_7tF2cP-0" value="New duplicates can be created in an active cohort." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;" parent="gnqIJqzOAcxfO6BO2laW-1" vertex="1">
          <mxGeometry x="866" y="1190" width="280" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hMZutguz3fgAF_7tF2cP-1" value="a) a third party tool is added to the cohort&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;" parent="gnqIJqzOAcxfO6BO2laW-1" vertex="1">
          <mxGeometry x="901" y="1230" width="240" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hMZutguz3fgAF_7tF2cP-2" value="b) attempts to create a duplicate element through the access services fails because the the repository services provide a complete view of the cohort&#39;s metadata and so duplicates can be avoided." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;" parent="gnqIJqzOAcxfO6BO2laW-1" vertex="1">
          <mxGeometry x="856" y="1744" width="1050" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hMZutguz3fgAF_7tF2cP-3" value="c) the services of the third party tool can only query the metadata in its own repository.&amp;nbsp; It is therefore unaware that duplicates at the cohort level are being created through its API." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;" parent="gnqIJqzOAcxfO6BO2laW-1" vertex="1">
          <mxGeometry x="910" y="2380" width="960" height="20" as="geometry" />
        </mxCell>
        <mxCell id="hMZutguz3fgAF_7tF2cP-4" value="d) the new duplicate is detected during a query that is made through the access services." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;" parent="gnqIJqzOAcxfO6BO2laW-1" vertex="1">
          <mxGeometry x="915" y="3010" width="490" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
